<?xml version="1.0" encoding="utf-8"?>
<!-- Gray vertical gradient sampled from the icon artwork's own edges
     (light at the top, deeper gray at the bottom) so the foreground
     artwork blends seamlessly under any launcher mask. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#D5D5D5"
        android:endColor="#A6A6A6"
        android:type="linear" />
</shape>
