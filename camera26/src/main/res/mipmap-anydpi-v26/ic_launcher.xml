<?xml version="1.0" encoding="utf-8"?>
<!-- App icon from the user's own artwork: lens image cut into a fluid
     iOS-style squircle (superellipse, ~23.5% equivalent corner radius,
     transparent outside) as the foreground, 88% centred over a gray
     gradient background matched to the artwork's edge falloff. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
